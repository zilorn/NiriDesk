# Copy to .env, then fill in REMOTE_PASSWORD and SESSION_SECRET.
# `make init` generates a complete .env for you.

PUID=1000
PGID=1000
BIND_ADDR=0.0.0.0
PORT=8080
XDG_RUNTIME_DIR=/run/user/1000
WAYLAND_DISPLAY=wayland-1

# Required. Use at least 8 characters.
REMOTE_PASSWORD=

# Recommended. Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL=12h

MAX_CLIENTS=4
WAYVNC_MAX_FPS=30
WAYVNC_OUTPUT=
WAYVNC_SHOW_CURSOR=true
WAYVNC_DISABLE_INPUT=false

# Set true only when a trusted reverse proxy sets X-Forwarded-For/Proto.
TRUST_PROXY=false
COOKIE_SECURE=auto
LOG_LEVEL=info

VERSION=0.1.0
COMMIT=local
